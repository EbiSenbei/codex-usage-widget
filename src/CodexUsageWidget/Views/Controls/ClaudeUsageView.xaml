<UserControl x:Class="CodexUsageWidget.Views.Controls.ClaudeUsageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CodexUsageWidget.Views.Controls">
    <Border Margin="17,0,17,8" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
        <StackPanel Margin="0,10,0,0">
            <TextBlock Text="Claude Code" FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" />
            <TextBlock Text="{Binding StatusText}" Margin="0,3,0,5" TextWrapping="Wrap"
                       Style="{StaticResource SupportingText}" />
            <ItemsControl ItemsSource="{Binding Limits}">
                <ItemsControl.ItemTemplate><DataTemplate><controls:UsageLimitRow /></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding UpdatedText}" FontSize="10.5" Margin="0,3,0,0"
                       Foreground="{DynamicResource TextTertiary}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
